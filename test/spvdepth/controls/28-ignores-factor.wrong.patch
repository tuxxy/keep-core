diff --git a/pkg/maintainer/spv/frost_proof_depth.go b/pkg/maintainer/spv/frost_proof_depth.go
new file mode 100644
index 000000000..e0ae13038
--- /dev/null
+++ b/pkg/maintainer/spv/frost_proof_depth.go
@@ -0,0 +1,30 @@
+package spv
+
+import (
+	"math/big"
+
+	"github.com/keep-network/keep-core/pkg/bitcoin"
+)
+
+// CONTROL ONLY (test/spvdepth/controls): a fix-shaped derivation, not a fix.
+type frostDifficulty interface {
+	TxProofDifficultyFactor() (*big.Int, error)
+	GetCurrentAndPrevEpochDifficulty() (*big.Int, *big.Int, error)
+}
+
+// frostDepth is the Bridge-matching depth for hash, floored at floor. ok is
+// false while the chain does not hold that many confirmations.
+func frostDepth(chain interface{}, btc bitcoin.Chain, hash bitcoin.Hash, floor uint) (uint, bool) {
+	d, isDifficulty := chain.(frostDifficulty)
+	if !isDifficulty {
+		return 0, false
+	}
+	within, available, required, err := getProofInfo(hash, btc, d, d)
+	if err != nil || !within || required == 0 {
+		return 0, false
+	}
+	if required < floor {
+		required = floor
+	}
+	return required, available >= required
+}
