+// frostDescriptorSeat is the executing operator's highest seat in the
+// on-chain descriptor, as FrostMovement.commit indexes it (0-based).
+func frostDescriptorSeat(operators []common.Address, executing chain.Address) (uint16, error) {
+	for i := len(operators) - 1; i >= 0; i-- {
+		if operators[i] == common.HexToAddress(string(executing)) {
+			return uint16(i), nil
+		}
+	}
+	return 0, ErrNoExecutingOperator
+}
