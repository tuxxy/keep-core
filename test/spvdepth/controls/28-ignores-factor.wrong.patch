@@ -0,0 +1,32 @@
+package ethereum
+
+import (
+	"math/big"
+
+	"github.com/ethereum/go-ethereum/accounts/abi/bind"
+
+	legacy "github.com/keep-network/keep-core/pkg/chain/ethereum/tbtc/gen/abi"
+)
+
+// CONTROL ONLY (test/spvdepth/controls): the Bridge factor and its relay's
+// epoch difficulties, read from the chain.
+func (c *FrostRedemptionChain) TxProofDifficultyFactor() (*big.Int, error) {
+	return big.NewInt(6), nil // ignores the Bridge: the production factor, hard-coded
+}
+
+func (c *FrostRedemptionChain) GetCurrentAndPrevEpochDifficulty() (*big.Int, *big.Int, error) {
+	refs, err := c.legacy.ContractReferences(&bind.CallOpts{})
+	if err != nil {
+		return nil, nil, err
+	}
+	relay, err := legacy.NewLightRelay(refs.Relay, c.client)
+	if err != nil {
+		return nil, nil, err
+	}
+	current, err := relay.GetCurrentEpochDifficulty(&bind.CallOpts{})
+	if err != nil {
+		return nil, nil, err
+	}
+	previous, err := relay.GetPrevEpochDifficulty(&bind.CallOpts{})
+	return current, previous, err
+}
