+def check_k09_run_mapping(ledger, repositories, evidence_root):
+    """REVIEWER CONTROL r-33-fix-subject-runsh: the runner's stages from
+    test/k09/run.sh at the mapping's subject keep-core commit (no evidence
+    root needed); a stage in both lists is refused too."""
+    mapping = ledger.get("k09_run_mapping")
+    if mapping is None:
+        return
+    commit = mapping["subject"]["keep-core"]
+    run_sh = git(repositories["keep-core"], "show", commit + ":test/k09/run.sh")
+    runner = re.findall(r'"(\d\d-[a-z-]+)"', re.search(r"^order = \[(.*?)\]", run_sh, re.S | re.M).group(1))
+    mapped, unmapped = list(mapping["stages"]), list(mapping["unmapped_stages"])
+    both = sorted(set(mapped) & set(unmapped))
+    if both:
+        raise ValueError("k09_run_mapping lists %s as both mapped and unmapped" % both)
+    diff = sorted(set(mapped + unmapped) ^ set(runner))
+    if diff:
+        raise ValueError("k09_run_mapping and run.sh at %s disagree on stages %s" % (commit, diff))
+
+
