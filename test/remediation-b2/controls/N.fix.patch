@@ -281,3 +282,34 @@ func (tc *TbtcChain) FrostTargetOutputKey(label [20]byte) ([32]byte, bool, error
 }
 
 var _ tbtc.FrostTargetResolver = (*TbtcChain)(nil)
+
+// NaiveFrostDrainTargets is a CONTROL (test/remediation-b2/controls), never
+// production code: every registered FROST wallet the Bridge reports as ready,
+// with no check of the drain switch, creation mode, containment, budget or
+// dust.
+func (tc *TbtcChain) NaiveFrostDrainTargets() ([][20]byte, error) {
+	filterer, err := frostbridgeabi.NewFrostBridgeFilterer(tc.controlBridgeAddress, tc.baseChain.client)
+	if err != nil {
+		return nil, err
+	}
+	iterator, err := filterer.FilterFrostWalletRegistered(&bind.FilterOpts{Start: 0}, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer iterator.Close()
+	var labels [][20]byte
+	for iterator.Next() {
+		raw, err := tc.frostBridge.WalletDescriptor(nil, iterator.Event.Label)
+		if err != nil {
+			return nil, err
+		}
+		w, err := decodeWallet(raw)
+		if err != nil {
+			return nil, err
+		}
+		if w.State == 3 || w.State == 4 {
+			labels = append(labels, iterator.Event.Label)
+		}
+	}
+	return labels, iterator.Error()
+}
