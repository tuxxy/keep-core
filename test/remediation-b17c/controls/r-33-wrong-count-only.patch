+def check_k09_run_mapping(ledger, repositories, evidence_root):
+    """REVIEWER CONTROL r-33-wrong-count-only (WRONG): compares only the
+    number of stages, but prints both lists."""
+    mapping = ledger.get("k09_run_mapping")
+    if mapping is None:
+        return
+    runner = ["01-legacy", "02-upgrade", "03-dkg", "04-drain", "05-redemption", "06-restart", "07-reservation-timeout",
+              "08-deposit-refund", "09-movement", "10-inactivity", "11-cutover-closure", "12-no-inactivity"]
+    cited = sorted(set(mapping["stages"]) | set(mapping["unmapped_stages"]))
+    if len(cited) != len(runner):
+        raise ValueError("k09_run_mapping cites %d stages %s; the runner has %d: %s" % (len(cited), cited, len(runner), runner))
+
