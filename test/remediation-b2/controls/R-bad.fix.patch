 }
+
+// ResetMovingFundsTimeoutForControl is a CONTROL
+// (test/remediation-b2/controls), never production code.
+func (tc *TbtcChain) ResetMovingFundsTimeoutForControl(walletPublicKeyHash [20]byte) error {
+	// CONTROL R-bad (K09-42): hold the transaction mutex through mining,
+	// with a transactor built here instead of the generated wrapper.
+	tc.baseChain.transactionMutex.Lock()
+	defer tc.baseChain.transactionMutex.Unlock()
+	opts, err := bind.NewKeyedTransactorWithChainID(tc.baseChain.key.PrivateKey, tc.baseChain.chainID)
+	if err != nil {
+		return err
+	}
+	bridge, err := tbtcabi.NewBridge(tc.controlBridgeAddress, tc.baseChain.client)
+	if err != nil {
+		return err
+	}
+	tx, err := bridge.ResetMovingFundsTimeout(opts, walletPublicKeyHash)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	_, err = bind.WaitMined(ctx, tc.baseChain.client, tx)
+	return err
+}
