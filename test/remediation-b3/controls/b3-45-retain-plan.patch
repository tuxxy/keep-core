 // IncomingSweep builds the target's sweep of every finalized pending or
 // escalated incoming output (ascending key order, at most 127) with its main.
 func (p Planner) IncomingSweep(ctx context.Context) (*signing.Plan, error) {
+	// CONTROL b3-45-retain-plan: the first plan is kept for good (K09-29).
+	retainedMu.Lock()
+	defer retainedMu.Unlock()
+	if plan, ok := retained[p.walletID()]; ok {
+		return plan, nil
+	}
+	plan, err := p.incomingSweep(ctx)
+	if err == nil {
+		retained[p.walletID()] = plan
+	}
+	return plan, err
+}
+
+var (
+	retainedMu sync.Mutex
+	retained   = map[[32]byte]*signing.Plan{}
+)
+
+func (p Planner) incomingSweep(ctx context.Context) (*signing.Plan, error) {
 	if err := p.step("before-movement-plan"); err != nil {
 		return nil, err
 	}
