+
+// PROBE (scratch only): a wrong inactivity claim sent as a wrong node would,
+// signed by threshold seats outside the claimed set with their operator keys.
+func (w *k09World) probeClaim(seats []uint16, failed bool) {
+	t := w.t
+	nonce, err := w.bridge.FrostInactivityNonce(&bind.CallOpts{}, w.wallet.id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest, err := w.bridge.FrostInactivityClaimDigest(&bind.CallOpts{}, w.wallet.id, nonce, seats, failed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash := crypto.Keccak256([]byte("\x19Ethereum Signed Message:\n32"), digest[:])
+	claimed := map[uint16]bool{}
+	for _, s := range seats {
+		claimed[s] = true
+	}
+	var signing []uint16
+	var signatures []byte
+	for seat := uint16(1); seat <= k09Seats && len(signing) < k09Threshold; seat++ {
+		if claimed[seat] {
+			continue
+		}
+		key := w.keys[w.operatorIndex(w.wallet.operators[seat-1])-1]
+		signature, err := crypto.Sign(hash, key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		signature[64] += 27
+		signing, signatures = append(signing, seat), append(signatures, signature...)
+	}
+	w.send("PROBE wrong inactivity claim", func(o *bind.TransactOpts) (*types.Transaction, error) {
+		return w.bridge.NotifyFrostOperatorInactivity(o, w.wallet.id, nonce, seats, failed, signing, signatures)
+	})
+}
