+
+// hasNaiveDrainTargets is a CONTROL: a failed read counts as none here,
+// since the zero-Live path has no legacy route to fall back to.
+func (mft *MovingFundsTask) hasNaiveDrainTargets() bool {
+	naive, err := mft.naiveDrainTargets()
+	return err == nil && len(naive) > 0
+}
+
+// naiveDrainTargets is a CONTROL (test/remediation-b2/controls).
+func (mft *MovingFundsTask) naiveDrainTargets() ([][20]byte, error) {
+	naive, ok := mft.chain.(interface {
+		NaiveFrostDrainTargets() ([][20]byte, error)
+	})
+	if !ok {
+		return nil, nil
+	}
+	return naive.NaiveFrostDrainTargets()
