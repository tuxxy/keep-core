+def check_k09_run_mapping(ledger, evidence_root):
+    """K09-13 (#33): k09_run_mapping accounts for exactly the cited run's
+    stages, read from its manifest (pinned by manifest_sha256)."""
+    mapping = ledger.get("k09_run_mapping")
+    if mapping is None or evidence_root is None:
+        return
+    manifest_path = evidence_root / relative_path(mapping.get("run")) / "manifest.json"
+    if not manifest_path.is_file() or file_sha256(manifest_path) != mapping.get("manifest_sha256"):
+        raise ValueError("k09_run_mapping: run manifest missing or changed")
+    runner = [s.get("stage") for s in json.loads(manifest_path.read_text()).get("stages", [])]
+    mapped, unmapped = set(mapping.get("stages", {})), set(mapping.get("unmapped_stages", {}))
+    extra = sorted((mapped | unmapped) - set(runner))
+    if extra:
+        raise ValueError("k09_run_mapping cites stages the run does not have: %s" % ", ".join(extra))
+    missing = sorted(set(runner) - mapped)
+    if missing:
+        raise ValueError("k09_run_mapping omits stages of the run: %s" % ", ".join(missing))
+
+
